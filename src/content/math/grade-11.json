  {
    "id": "math-11-005",
    "grade": 11,
    "category": "Optimización elemental",
    "subcategory": "Máximo de función cuadrática",
    "difficulty": 4,
    "type": "numeric",
    "title": "Optimización del Área de un Rectángulo",
    "question": "Se dispone de 40 metros de malla para cercar un terreno rectangular. ¿Cuál es el área MÁXIMA posible en m^2?",
    "latex": "A(x) = x(20 - x)",
    "answer": "100",
    "solution": [
      {
        "latex": "2x + 2y = 40 \\implies x + y = 20 \\implies y = 20 - x",
        "explanation": "Perímetro fijo."
      },
      {
        "latex": "A(x) = 20x - x^2",
        "explanation": "Función de área."
      },
      {
        "latex": "x_{\\text{máx}} = -\\frac{20}{2(-1)} = 10 \\implies y = 10",
        "explanation": "El área máxima se alcanza con un cuadrado de 10x10."
      },
      {
        "latex": "A_{\\text{máx}} = 10 \\times 10 = 100",
        "explanation": "Área máxima 100 m^2."
      }
    ],
    "hints": [
      "El área máxima de un rectángulo con perímetro fijo se logra cuando es un cuadrado (lados de 10 m)."
    ]
  },
