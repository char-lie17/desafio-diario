      "(x + 5)/2",
      "(x - 5)/2",
      "5x - 2",
      "1/(2x - 5)"
    ],
    "solution": [
      {
        "latex": "y = 2x - 5",
        "explanation": "Escribimos la función como y en términos de x."
      },
      {
        "latex": "y + 5 = 2x \\implies x = \\frac{y + 5}{2}",
        "explanation": "Despejamos la variable x."
      },
      {
        "latex": "f^{-1}(x) = \\frac{x + 5}{2}",
        "explanation": "Intercambiamos las variables x e y."
      }
    ],
    "hints": [
